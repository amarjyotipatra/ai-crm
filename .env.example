# Backend Database Configuration (SQLite default; PostgreSQL optional)
DATABASE_URL=sqlite:///./crm.db
# DATABASE_URL=postgresql://user:password@localhost:5432/crm_db

# Google Gemini API Key for Live AI Capabilities (Fallback generator activates automatically if left blank)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API URL
VITE_API_URL=http://localhost:8000
